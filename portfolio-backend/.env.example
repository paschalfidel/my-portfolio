NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Comma-separated frontend origins permitted by CORS. Do not include paths.
ALLOWED_ORIGINS=http://localhost:5173

# Gmail address and app password used for portfolio notifications.
EMAIL_USER=you@example.com
EMAIL_PASS=replace-with-an-app-password

# Optional development SMTP credentials.
ETHEREAL_EMAIL=
ETHEREAL_PASSWORD=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
